{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Queue Counter",
  "version": "0.1.0",
  "identifier": "com.bamso.counter",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Queue - Gọi số",
        "width": 600,
        "height": 300,
        "minWidth": 400,
        "minHeight": 250,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http: https: ws: wss: tauri:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": "v1Compatible",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY2NEY0MUM5OTE5NzUwClJXUlFsNUhKUVUvMkFBZGZYNG0vMUFXMmYrVS9qVWt1SmFvT092TW1tcjdiT0V5N2pZMEQ4bVVoCg==",
      "endpoints": [
        "https://github.com/vuvantang/queue-system/releases/latest/download/counter-update.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
