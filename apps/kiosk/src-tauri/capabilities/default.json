{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Kiosk main window only. The remote 'tv-display' window is intentionally not listed in any capability, so it has no IPC access.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "autostart:default",
    "dialog:default",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "updater:default",
    "process:allow-restart",
    "log:default",
    "allow-list-monitors",
    "allow-list-printers",
    "allow-print-ticket",
    "allow-open-tv-window",
    "allow-close-tv-window",
    "allow-play-ding",
    "allow-speak-vietnamese",
    "allow-preload-tts",
    "allow-get-tts-cache-path",
    "allow-get-machine-info",
    "allow-open-log-dir"
  ]
}
